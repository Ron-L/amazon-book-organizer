[backup_sync]
# Path to sync backups to (e.g., C:/Users/You/Dropbox/ReaderWrangler)
# Leave empty to disable backup sync
path =

# Number of backups to keep in sync folder
keep_count = 1

[dir_sync]
# Sync directories to backup locations
# Format: source_path = destination_path
# Both can be relative (resolved against script directory) or absolute
#
# Example:
# .private = C:/Users/You/OneDrive/Projects/MyProject/.private
# secrets = C:/Users/You/Dropbox/Backups/secrets
#
# Features:
# - Only copies files that have changed (incremental sync)
# - Deletes files in dest that no longer exist in source
# - Uses .last-sync marker file in dest for fast "nothing changed" detection
# - Runs every 60 seconds along with other dev-tasks
